  .mk svg text.big-year { font: 650 19px "Geist", sans-serif; fill: var(--head); }
  .mk svg text.pill { font: 600 12px "Geist", sans-serif; fill: #fff; }
  .mk svg text.sub2 { font: italic 11px "Geist", sans-serif; fill: var(--kw-muted); }
  .kw-dog .notes { display: grid; grid-template-columns: max-content 1fr; gap: .25rem .9rem; margin: .8rem 0 0; padding-top: .7rem; border-top: 1px solid var(--rule); font-size: .82em; }
  .kw-dog .notes dt { color: var(--head); font-weight: 600; font-variant-numeric: tabular-nums; }
  .kw-dog .notes dd { margin: 0; }
</style>
