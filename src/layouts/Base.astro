---
import "../styles/site.css";
import "../styles/syntax.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description = site.description, path = Astro.url.pathname } = Astro.props;
const url = new URL(path, site.url).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} · ${site.title}` : site.title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title ?? site.title}>
<meta property="og:url" content={url}>
<link rel="canonical" href={url}>
<link rel="alternate" type="application/rss+xml" href={`${site.url}/index.xml`} title={site.title}>
<script is:inline>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Geist:wght@400;600&family=Geist+Mono:wght@400&family=Onest:wght@500&display=swap">
</head>
<body>
<slot />
<script>import "../scripts/site.js";</script>
</body>
</html>
